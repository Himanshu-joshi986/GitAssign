# Copy this file to .env and fill in your values
# cp .env.example .env

# GitHub personal access token (optional but strongly recommended)
# Without this you hit the unauthenticated rate limit: 60 req/hour
# With token: 5000 req/hour
# Create one at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# Database path (inside container, keep as default unless you know why)
DB_PATH=data/gitassign.db

# Cache directory for raw GitHub API responses
CACHE_DIR=data/cache

# Maximum commit details fetched for file-based responsibility scoring
MAX_COMMIT_DETAILS=200

# Automatically assign new unassigned open issues during live sync
AUTO_ASSIGN_NEW_ISSUES=false
AUTO_ASSIGN_CAPACITY=3
# Mention the assigned developer in a GitHub comment
AUTO_NOTIFY_DEVELOPER=false

# Scoring weights config path
WEIGHTS_PATH=config/weights.json
