# Environment
.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# Data — exclude raw cache and DB (large files)
data/cache/
data/*.db
data/*.db-wal
data/*.db-shm

# Backend-local runtime data
backend/data/
backend/*.db
backend/*.db-wal
backend/*.db-shm

# Keep cleaned CSVs in data/
!data/*.csv
!data/README.md

# Frontend
node_modules/
frontend/dist/

# Local work notes and disposable checks
*.local.md
*_runtime.db

# Built static files (generated by npm run build)
backend/static/

# Docker
.dockerignore

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log
uvicorn.log

# Pytest
.pytest_cache/
.coverage
htmlcov/

# MLflow / experiment artifacts
mlruns/
